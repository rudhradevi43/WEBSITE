NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visapath?schema=public

# API
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PASSWORD_PEPPER=replace-with-a-long-random-pepper
UPLOAD_DIR=uploads

# Frontend auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-nextauth-secret
NEXT_PUBLIC_API_URL=http://localhost:4000

# AI and email
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=VisaPath AI <notifications@visapath.ai>

# CORS
ALLOWED_ORIGINS=http://localhost:3000
